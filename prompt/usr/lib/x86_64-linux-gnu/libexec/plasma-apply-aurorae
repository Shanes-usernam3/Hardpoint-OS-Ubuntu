#!/bin/bash

# TODO Plasma 7: Drop aurorae.knsrc, use knsrc file provided by KWin.

if [ -f "/usr/lib/x86_64-linux-gnu/libexec/kwin-applywindowdecoration" ]; then
    "/usr/lib/x86_64-linux-gnu/libexec/kwin-applywindowdecoration" "$@"
elif [ -f "/usr/lib/x86_64-linux-gnu/libexec/kwin-applywindowdecoration-x11" ]; then
    "/usr/lib/x86_64-linux-gnu/libexec/kwin-applywindowdecoration-x11" "$@"
else
    echo "Neither kwin_x11 nor kwin_wayland is installed"
    exit 1
fi
