      <message xml:lang="uk">Скинути параметри SDDM до типових для системи</message>
      <message xml:lang="zh_CN">重置 SDDM 设置为默认值</message>
      <message xml:lang="zh_TW">重設 SDDM 設定至原廠預設設定</message>
      <defaults>
         <allow_inactive>no</allow_inactive>
         <allow_active>auth_admin</allow_active>
      </defaults>
