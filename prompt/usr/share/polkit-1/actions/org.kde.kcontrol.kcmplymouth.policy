      <description xml:lang="pl">Usuń nowy wygląd Plymouth</description>
      <description xml:lang="pt">Desinstalar um Tema do Plymouth</description>
      <description xml:lang="pt_BR">Desinstalar um novo tema do Plymouth</description>
      <description xml:lang="ro">Dezinstalează tematică Plymouth nouă</description>
      <description xml:lang="ru">Удаление темы Plymouth</description>
      <description xml:lang="sa">एकं नूतनं Plymouth Theme अनइन्स्टॉल कुर्वन्तु</description>
      <description xml:lang="sk">Odinštalovať nové tému Plymouth</description>
      <description xml:lang="sl">Odstrani temo za Plymouth</description>
      <description xml:lang="sr">Деинсталирај нову Плимутову тему</description>
      <description xml:lang="sv">Avinstallera ett nytt Plymouth-tema</description>
      <description xml:lang="tr">Plymouth Temasını Kaldır</description>
      <description xml:lang="uk">Вилучення теми Plymouth</description>
      <description xml:lang="zh_CN">卸载新的 Plymouth 主题</description>
      <description xml:lang="zh_TW">解除安裝新 Plymouth 主題</description>
      <message xml:lang="ar">الاستيثاق لإزالة سمة Plymouth.</message>
      <message xml:lang="be"></message>
      <message xml:lang="bg"></message>
      <message xml:lang="ca">Autenticació per a desinstal·lar un tema del Plymouth.</message>
      <message xml:lang="cs">Pro odinstalaci motivu Plymouth je potřeba ověřit vaši totožnost.</message>
