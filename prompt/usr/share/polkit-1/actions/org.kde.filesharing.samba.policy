<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE policyconfig PUBLIC
"-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
"http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
<vendor>KIO Samba Sharing</vendor>
<vendor_url>https://www.kde.org</vendor_url>
<icon_name>preferences-system-network-share-windows</icon_name>
   <action id="org.kde.filesharing.samba.addtogroup" >
      <description xml:lang="ar">أضف مستخدمًا إلى مجموعة مشاركة المستخدمين الخاصة بسامبا</description>
      <description xml:lang="az">Sambanın istifadəçi paylaşımı qrupuna istifadəçi əlavə etmək</description>
      <description xml:lang="be">Дадаць карыстальніка ў групу Usershare Samba</description>
      <description xml:lang="bg">Добавяне на потребител към група за споделяния на Samba</description>
      <description xml:lang="ca">Afegeix un usuari al grup «usershare» del Samba</description>
      <description xml:lang="da">Tilføj bruger til Samba's brugerdelingsgruppe</description>
      <description xml:lang="de">Benutzer zur Samba-Gruppe „sambashare“ hinzufügen</description>
      <description xml:lang="el">Προσθήκη χρήστη στην κοινόχρηστη ομάδα της Samba</description>
      <description>Add User to Samba's Usershare Group</description>
      <description xml:lang="en_GB">Add User to Samba's Usershare Group</description>
      <description xml:lang="eo">Aldoni uzanton al uzantkomuniga grupo de Samba</description>
      <description xml:lang="es">Añadir usuario al grupo Usershare de Samba</description>
      <description xml:lang="eu">Gehitu erabiltzailea Sambaren «usershare» taldean</description>
      <description xml:lang="fi">Lisää käyttäjä Samban käyttäjäjakoryhmään</description>
      <description xml:lang="fr">Ajouter l'utilisateur au groupe de partage « Samba »</description>
      <description xml:lang="gl">Engadindo a usuaria ao grupo de Samba</description>
      <description xml:lang="he">הוספת משתמש לקבוצת שיתופי משתמשים של Samba</description>
      <description xml:lang="hu">Felhasználó hozzáadása a Samba Usershare csoporthoz</description>
      <description xml:lang="ia">Adde usator a Gruppo de UserShare de Samba</description>
      <description xml:lang="id">Tambahkan Pengguna ke Grup Usershare Samba</description>
      <description xml:lang="is">Bæti notanda við Usershare-hóp Samba</description>
      <description xml:lang="it">Aggiungi utente al gruppo usershare di Samba</description>
      <description xml:lang="ka">მომხმარებლის Samba-ის გაზიარებულის ჯგუფში ჩამატება</description>
      <description xml:lang="ko">사용자를 Samba의 Usershare 그룹에 추가</description>
      <description xml:lang="lt">Pridėti naudotoją į Samba naudotojo viešinių grupę</description>
      <description xml:lang="lv">Pievienot lietotāju „Samba“ „usershare“ kopīgošanas grupai</description>
      <description xml:lang="nl">Gebruiker aan Usershare-groep van Samba toevoegen</description>
      <description xml:lang="nn">Legg til brukar i Sambas Usershare-gruppe</description>
      <description xml:lang="pl">Dodaj użytkownika do grupy Samby usershare</description>
      <description xml:lang="pt">Adicionar o Utilizador ao Grupo de Partilhas do Samba</description>
      <description xml:lang="pt_BR">Adicionar o usuário ao grupo de usuários Samba</description>
      <description xml:lang="ro">Adaugă utilizatorul la grupul Samba „usershare”</description>
      <description xml:lang="ru">Добавление пользователя в группу Samba</description>
      <description xml:lang="sa">Samba इत्यस्य Usershare Group इत्यत्र User योजयन्तु</description>
      <description xml:lang="sl">Dodajte uporabnika v skupino skupnih virov Sambe</description>
      <description xml:lang="sv">Lägg till användare i Sambas Usershare-grupp</description>
      <description xml:lang="tr">Kullanıcıyı Samba’nın Kullanıcı Paylaşımı Grubuna Ekle</description>
      <description xml:lang="uk">Додати користувача до спільної групи Samba</description>
      <description xml:lang="zh_CN">添加用户到 Samba 共享用户组</description>
      <description xml:lang="zh_TW">將使用者加入 Samba 的使用者分享 (Usershare) 群組</description>
      <message xml:lang="ar">يضيف مستخدم إلى مجموعة مشاركة المستخدمين في سامبا لتحرير مشاركات المستخدمين في سامبا</message>
      <message xml:lang="az">Samba istifadəçi paylaşımına düzəliş etmək üçün Sambanın istifadəçi paylaşımı qrupuna istifadəçi əlavə edilməsi</message>
      <message xml:lang="be">Дадаванне карыстальніка ў групу карыстальнікаў для абагульвання з дапамогай Samba</message>
      <message xml:lang="bg">Добавяне на потребител към група за споделяния на Samba за обработка на потребителски споделяния</message>
      <message xml:lang="ca">Afegeix un usuari al grup «usershare» del Samba per a editar les comparticions d'usuaris del Samba</message>
      <message xml:lang="da">Tilføjer bruger til Samba's brugerdelingsgruppe for at redigere Samba-brugerdelinger</message>
      <message xml:lang="de"></message>
      <message xml:lang="el">Προσθήκη χρήστη στην κοινόχρηστη ομάδα της Samba για επεξεργασία των κοινών πόρων</message>
      <message>Adding user to Samba's usershare group to edit Samba usershares</message>
      <message xml:lang="en_GB">Adding user to Samba's usershare group to edit Samba usershares</message>
      <message xml:lang="eo">Aldonante uzanton al Samba-uzantkomuniga grupo por redakti Samba-uzantkomunigojn</message>
      <message xml:lang="es">Añadiendo usuario al grupo usershare de Samba para editar los recursos compartidos de los usuarios de Samba</message>
      <message xml:lang="eu"></message>
      <message xml:lang="fi">Lisätään käyttäjän Samban käyttäjäjakoryhmään Samban käyttäjäjakojen muokkaamiseksi</message>
      <message xml:lang="fr">Ajout de l'utilisateur au groupe de partage « Samba » pour pouvoir modifier le groupe</message>
      <message xml:lang="gl">Engadindo a persoa ao grupo de Samba que permite editar as comparticións de persoas usuarias.</message>
      <message xml:lang="he">משתמש נוסף לקבוצת שיתופי משתמשים של Samba כדי לערוך שיתופי משתמשים של Samba</message>
      <message xml:lang="hu">Felhasználó hozzáadása a Samba usershare csoporthoz a felhasználói megosztások szerkesztéséhez</message>
      <message xml:lang="ia">Addente usator al gruppo de usershare de Samba pro editar usershares de Samba</message>
      <message xml:lang="id">Menambahkan pengguna ke grup usershare Samba untuk mengedit usershare Samba</message>
      <message xml:lang="is">Bæti notanda við Usershare-hóp Samba til að breyta Samba-notandasameignum</message>
      <message xml:lang="it">Aggiunta dell'utente al gruppo usershare di Samba per modificare le condivisioni utente di Samba</message>
      <message xml:lang="ka">მომხმარებლის Samba-ის გაზიარებულის ჯგუფში ჩამატება</message>
      <message xml:lang="ko">Samba 사용자 공유를 편집할 수 있도록 사용자를 Samba의 Usershare 그룹에 추가 중</message>
      <message xml:lang="lt"></message>
      <message xml:lang="lv"></message>
      <message xml:lang="nl">Gebruiker aan Usershare-groep van Samba wordt toegevoegd om Samba-usershares te bewerken</message>
      <message xml:lang="nn">Legg til brukarne i Sambas Usershare-gruppe for å redigera Samba-«usershares»</message>
      <message xml:lang="pl"></message>
      <message xml:lang="pt">A adicionar o utilizador ao grupo de partilha do Samba para poder editar as partilhas de utilizadores do Samba</message>
      <message xml:lang="pt_BR">Adicionando o usuário ao grupo de usuários Samba para editar o grupo de usuários</message>
      <message xml:lang="ro">Se adaugă utilizatorul la grupul Samba „usershares” pentru a modifica partajări de utilizator</message>
      <message xml:lang="ru">Добавление пользователя в группу Samba для управления пользовательскими ресурсами Samba</message>
      <message xml:lang="sa">साम्बा उपयोक्तृसाझेदारी सम्पादयितुं साम्बा इत्यस्य उपयोक्तृसाझेदारीसमूहे उपयोक्तारं योजयित्वा</message>
      <message xml:lang="sl">Dodajanje uporabnika v skupino uporabnikov Sambe za urejanje skupnih virov Sambe</message>
      <message xml:lang="sv">Lägger till användare i Sambas Usershare-grupp för att redigera Samba användardelningar</message>
      <message xml:lang="tr">Samba kullanıcı paylaşımlarını düzenlemek için kullanıcıyı Samba’nın kullanıcı paylaşımı grubuna ekle</message>
      <message xml:lang="uk">Додавання користувача до спільної групи користувачів Samba для редагування спільних ресурсів користувачів Samba</message>
      <message xml:lang="zh_CN">正在添加用户到 Samba 的共享用户组以便编辑 Samba 用户共享</message>
      <message xml:lang="zh_TW">正在將使用者加入 Samba 的使用者分享 (Usershare) 群組來編輯 Samba 使用者分享</message>
      <defaults>
         <allow_inactive>auth_admin</allow_inactive>
         <allow_active>auth_admin</allow_active>
      </defaults>
   </action>
   <action id="org.kde.filesharing.samba.createuser" >
      <description xml:lang="ar">يعيين كلمة سر لمستخدم سامبا</description>
