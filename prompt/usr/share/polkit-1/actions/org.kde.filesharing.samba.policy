   <action id="org.kde.filesharing.samba.isuserknown" >
      <description xml:lang="ar">هل مستخدم سامبا معروف</description>
      <description xml:lang="az">Samba istifadəçisi bilinir</description>
      <description xml:lang="be">Ці вядомы карыстальнік Samba</description>
      <description xml:lang="bg">Известен ли е потребител на Samba</description>
      <description xml:lang="ca">Si es coneix l'usuari Samba</description>
      <description xml:lang="da">Er Samba-bruger kendt</description>
      <description xml:lang="de">Ist der Samba-Benutzer bekannt</description>
      <description xml:lang="el">Είναι ο χρήστης της Samba γνωστός</description>
      <description>Is Samba User Known</description>
      <description xml:lang="en_GB">Is Samba User Known</description>
      <description xml:lang="eo">Ĉu Samba-uzanto konata</description>
      <description xml:lang="es">Si el usuario de Samba es conocido</description>
      <description xml:lang="eu">Samba erabiltzailea ezaguna den</description>
      <description xml:lang="fi">Onko Samba-käyttäjä tunnettu</description>
      <description xml:lang="fr">L'utilisateur « Samba » est-il connu ?</description>
      <description xml:lang="gl">Coñécese a usuaria de Samba</description>
      <description xml:lang="he">האם משתמש ה־Samba ידוע</description>
      <description xml:lang="hu">Ismert-e a Samba felhasználó?</description>
      <description xml:lang="ia">Es usator de Samba cognoscite</description>
      <description xml:lang="id">Biasa Dikenal Pengguna sebagai Samba</description>
      <description xml:lang="is">Er Samba-notandi þekktur</description>
      <description xml:lang="it">L'utente Samba è conosciuto?</description>
      <description xml:lang="ka"></description>
      <description xml:lang="ko">Samba 사용자가 알려졌는지 여부</description>
      <description xml:lang="lt">Ar Samba naudotojas yra žinomas</description>
      <description xml:lang="lv">Vai „Samba“ lietotājs ir zināms</description>
      <description xml:lang="nl">Is Samba-gebruiker bekend</description>
      <description xml:lang="nn">Er Samba-brukaren kjend</description>
      <description xml:lang="pl">Czy użytkownik Samby jest znany</description>
      <description xml:lang="pt">Se o Utilizador do Samba é Conhecido</description>
      <description xml:lang="pt_BR">O usuário Samba é conhecido</description>
      <description xml:lang="ro">Este cunoscut utilizatorul Samba</description>
      <description xml:lang="ru">Проверка существования пользователя Samba</description>
      <description xml:lang="sa">साम्बा उपयोक्ता ज्ञातः अस्ति वा</description>
      <description xml:lang="sl">Ali je uporabnik Sambe znan</description>
      <description xml:lang="sv">Är Samba-användare känd</description>
      <description xml:lang="tr">Samba Kullanıcısı Durumu</description>
      <description xml:lang="uk">Чи є користувач Samba</description>
      <description xml:lang="zh_CN">Samba 用户是否已知</description>
      <description xml:lang="zh_TW">Samba 使用者是否已知</description>
      <message xml:lang="ar">يتحقق من وجود مستخدم سامبا</message>
      <message xml:lang="az">Samba istifadəçisinin mövcudluğu yoxlanılır</message>
      <message xml:lang="be">Правяранне існавання карыстальніка Samba</message>
      <message xml:lang="bg">Проверка за съществуване на потребител на Samba</message>
      <message xml:lang="ca">Comprovació d'existència de l'usuari Samba</message>
      <message xml:lang="da">Tjekker om Samba-bruger eksisterer</message>
      <message xml:lang="de"></message>
      <message xml:lang="el">Ελέγχει αν ο χρήστης της Samba υπάρχει</message>
      <message>Checking if Samba user exists</message>
      <message xml:lang="en_GB">Checking if Samba user exists</message>
      <message xml:lang="eo">Kontrolante ĉu Samba-uzanto ekzistas</message>
      <message xml:lang="es">Comprobando si el usuario de Samba existe</message>
      <message xml:lang="eu">Samba erabiltzailea badagoen egiaztatzea</message>
      <message xml:lang="fi"></message>
      <message xml:lang="fr">Vérification de l'existence de l'utilisateur « Samba »</message>
      <message xml:lang="gl">Comprobando se a persoa usuaria de Samba existe.</message>
      <message xml:lang="he">מתבצעת בדיקה אם משתמש ה־Samba קיים</message>
      <message xml:lang="hu">A Samba felhasználó létezésének ellenőrzése</message>
      <message xml:lang="ia">Verificante si usator de Samba existe</message>
      <message xml:lang="id">Memeriksa apakah ada pengguna Samba</message>
      <message xml:lang="is">Kanna hvort Samba-notandi er til</message>
      <message xml:lang="it">Verifica dell'esistenza dell'utente Samba</message>
      <message xml:lang="ka"></message>
      <message xml:lang="ko">Samba 사용자 존재 여부 검사 중</message>
      <message xml:lang="lt"></message>
      <message xml:lang="lv"></message>
      <message xml:lang="nl">Controleren of Samba-gebruiker bestaat</message>
      <message xml:lang="nn">Sjekkar om Samba-brukaren finst</message>
      <message xml:lang="pl"></message>
      <message xml:lang="pt">A verificar se o utilizador do Samba existe</message>
      <message xml:lang="pt_BR">Verificando se o usuário Samba existe</message>
      <message xml:lang="ro">Se verifică dacă utilizatorul Samba există</message>
      <message xml:lang="ru">Проверка существования пользователя Samba</message>
      <message xml:lang="sa">साम्बा उपयोक्ता अस्ति वा इति परीक्ष्य</message>
      <message xml:lang="sk">Kontrolujem či používateľ Samba existuje</message>
      <message xml:lang="sl"></message>
      <message xml:lang="sv">Kontrollerar om Samba-användare finns</message>
      <message xml:lang="tr">Samba kullanıcısının var olup olmadığı denetleniyor</message>
      <message xml:lang="uk"></message>
      <message xml:lang="zh_CN">正在检查 Samba 用户是否存在</message>
      <message xml:lang="zh_TW">正在檢查 Samba 使用者是否存在</message>
      <defaults>
         <allow_inactive>yes</allow_inactive>
         <allow_active>yes</allow_active>
      </defaults>
   </action>
</policyconfig>
