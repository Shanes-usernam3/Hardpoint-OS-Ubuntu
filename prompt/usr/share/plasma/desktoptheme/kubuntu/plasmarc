# Docs: https://develop.kde.org/docs/plasma/theme/theme-details
[Wallpaper]
defaultWallpaperTheme=Kubuntu
defaultFileSuffix=.svg
defaultWidth=1920
defaultHeight=1080
# This is supposed to enable day-night mode, but it does not
DynamicMode=1

[ContrastEffect]
enabled=true
contrast=1.0
saturation=1.5

[AdaptiveTransparency]
enabled=true
