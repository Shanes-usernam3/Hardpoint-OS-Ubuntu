#!/bin/sh

PREREQ=""
DESCRIPTION="Disabling gnome-initial-setup..."

prereqs()
{
       echo "$PREREQ"
}

case $1 in
# get pre-requisites
prereqs)
       prereqs
       exit 0
       ;;
esac

. /scripts/casper-functions

log_begin_msg "$DESCRIPTION"

# Users want to try Ubuntu GNOME, not configure their system
mkdir -p /root/home/$USERNAME/.config/systemd/user
ln -s /dev/null /root/home/$USERNAME/.config/systemd/user/gnome-initial-setup-first-login.service
ln -s /dev/null /root/home/$USERNAME/.config/systemd/user/gnome-initial-setup-upgrade-login.service
chroot /root chown -R $USERNAME.$USERNAME /home/$USERNAME/.config

log_end_msg
