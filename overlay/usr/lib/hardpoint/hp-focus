#!/usr/bin/env bash
# Focus mode: no notification pop-ups + warm Night Light. Your own settings come back when it's off.
#   hp-focus on|off|toggle|status
set -uo pipefail
st="${XDG_CONFIG_HOME:-$HOME/.config}/hardpoint/focus-saved"
N=org.gnome.desktop.notifications
C=org.gnome.settings-daemon.plugins.color
status() { [[ -f $st ]] && echo on || echo off; }
on() {
    [[ -f $st ]] && return
    mkdir -p "$(dirname "$st")"
    printf '%s\n%s\n' "$(gsettings get $N show-banners)" "$(gsettings get $C night-light-enabled)" > "$st"
    gsettings set $N show-banners false
    gsettings set $C night-light-enabled true
    gsettings set $C night-light-schedule-automatic false 2>/dev/null
    gsettings set $C night-light-schedule-from 0.0
    gsettings set $C night-light-schedule-to 23.99
    notify-send -i hardpoint "Focus mode on" "Notifications are silenced and Night Light is on." 2>/dev/null || true
}
off() {
    [[ -f $st ]] || return
    local b n
    { read -r b; read -r n; } < "$st"
    gsettings set $N show-banners "${b:-true}"
    gsettings set $C night-light-enabled "${n:-false}"
    gsettings reset $C night-light-schedule-automatic
    gsettings reset $C night-light-schedule-from
    gsettings reset $C night-light-schedule-to
    rm -f "$st"
    notify-send -i hardpoint "Focus mode off" 2>/dev/null || true
}
case "${1:-toggle}" in
    on) on ;;
    off) off ;;
    status) status ;;
    toggle) if [[ $(status) == on ]]; then off; else on; fi ;;
    *) echo "usage: hp-focus on|off|toggle|status" >&2; exit 2 ;;
esac
