#!/usr/bin/env bash
# App shortcuts (.desktop files) put on the desktop work straight away:
# mark them executable and trusted, so there's no "Allow Launching" step.
set -uo pipefail
desk="$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")"
[[ -d $desk ]] || exit 0
for f in "$desk"/*.desktop; do
    [[ -f $f && ! -L $f ]] || continue
    [[ $(stat -c %U "$f") == "$(id -un)" ]] || continue
    chmod u+x "$f" 2>/dev/null
    [[ $(gio info -a metadata::trusted "$f" 2>/dev/null) == *"metadata::trusted: true"* ]] ||
        gio set "$f" metadata::trusted true 2>/dev/null
done
exit 0
