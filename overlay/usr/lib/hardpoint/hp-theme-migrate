#!/usr/bin/env bash
# Once per user at sign-in: switch to the HardPoint (Byte) theme and the Papirus icons.
# Runs again only when HardPoint ships a new look (bump VER); later changes you make yourself stay.
set -uo pipefail

# Desktop icons (files and app shortcuts on the desktop) on for every account, once;
# switching it off later in Extensions is respected
dmark="${XDG_CONFIG_HOME:-$HOME/.config}/hardpoint/desktop-icons"
if [[ ! -f $dmark ]] && [[ -d /usr/share/gnome-shell/extensions/zorin-desktop-icons@zorinos.com ]]; then
    gnome-extensions enable zorin-desktop-icons@zorinos.com 2>/dev/null ||
        gsettings set org.gnome.shell enabled-extensions \
            "$(python3 -c 'import ast,sys; l=ast.literal_eval(sys.argv[1] if sys.argv[1].startswith("[") else "[]"); u="zorin-desktop-icons@zorinos.com"; l+=[u] if u not in l else []; print(l)' "$(gsettings get org.gnome.shell enabled-extensions | sed "s/^@as //")")"
    mkdir -p "$(dirname "$dmark")" && date '+%F' > "$dmark"
fi

# Windows 11 layout for accounts that existed before it shipped (once; later changes stay)
wmark="${XDG_CONFIG_HOME:-$HOME/.config}/hardpoint/win11-layout-2"
if [[ ! -f $wmark ]] && command -v dconf >/dev/null; then
    dconf write '/org/gnome/shell/extensions/zorin-taskbar/panel-margin' '0'
    dconf write '/org/gnome/shell/extensions/zorin-taskbar/panel-element-positions' ''\''{"0":[{"element":"showAppsButton","visible":false,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"centerMonitor"},{"element":"taskbar","visible":true,"position":"centerMonitor"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}],"1":[{"element":"showAppsButton","visible":false,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"centerMonitor"},{"element":"taskbar","visible":true,"position":"centerMonitor"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}],"2":[{"element":"showAppsButton","visible":false,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"centerMonitor"},{"element":"taskbar","visible":true,"position":"centerMonitor"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}],"3":[{"element":"showAppsButton","visible":false,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"centerMonitor"},{"element":"taskbar","visible":true,"position":"centerMonitor"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}]}'\'''
    dconf write '/org/gnome/shell/extensions/zorin-taskbar/panel-element-positions-monitors-sync' 'true'
    dconf write '/org/gnome/shell/extensions/zorin-taskbar/panel-position' ''\''BOTTOM'\'''
    dconf write '/org/gnome/shell/extensions/zorin-taskbar/dot-style-focused' ''\''DASHES'\'''
    dconf write '/org/gnome/shell/extensions/zorin-taskbar/dot-style-unfocused' ''\''DOTS'\'''
    dconf write '/org/gnome/shell/extensions/zorin-taskbar/show-showdesktop-icon' 'true'
    dconf write '/org/gnome/shell/extensions/zorin-taskbar/showdesktop-button-width' '6'
    dconf write '/org/gnome/shell/extensions/zorin-taskbar/global-border-radius' '2'
    dconf write '/org/gnome/shell/extensions/zorin-menu/layout' ''\''APP_GRID'\'''
    dconf write '/org/gnome/shell/extensions/zorin-menu/super-hotkey' 'true'
    dconf write '/org/gnome/shell/keybindings/focus-active-notification' '@as []'
    dconf write '/org/gnome/shell/keybindings/toggle-overview' '['\''<Alt>space'\'', '\''<Super>s'\'', '\''<Super>Tab'\'']'
    dconf write '/org/gnome/shell/keybindings/toggle-quick-settings' '['\''<Super>a'\'']'
    dconf write '/org/gnome/shell/keybindings/toggle-application-view' '@as []'
    dconf write '/org/gnome/shell/keybindings/toggle-message-tray' '['\''<Super>n'\'', '\''<Super>m'\'']'
    dconf write '/org/gnome/shell/keybindings/show-screenshot-ui' '['\''Print'\'', '\''<Shift><Super>s'\'']'
    dconf write '/org/gnome/desktop/wm/keybindings/switch-applications' '@as []'
    dconf write '/org/gnome/desktop/wm/keybindings/switch-applications-backward' '@as []'
    dconf write '/org/gnome/desktop/wm/keybindings/switch-windows' '['\''<Alt>Tab'\'']'
    dconf write '/org/gnome/desktop/wm/keybindings/switch-windows-backward' '['\''<Shift><Alt>Tab'\'']'
    dconf write '/org/gnome/desktop/wm/keybindings/show-desktop' '['\''<Super>d'\'']'
    dconf write '/org/gnome/settings-daemon/plugins/media-keys/home' '['\''<Super>e'\'']'
    dconf write '/org/gnome/settings-daemon/plugins/media-keys/control-center' '['\''<Super>i'\'']'
    dconf write '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings' '['\''/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/hp-taskmgr/'\'']'
    dconf write '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/hp-taskmgr/name' ''\''Task Manager'\'''
    dconf write '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/hp-taskmgr/binding' ''\''<Primary><Shift>Escape'\'''
    dconf write '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/hp-taskmgr/command' ''\''gnome-system-monitor'\'''
    dconf write '/org/gnome/desktop/wm/preferences/button-layout' ''\''appmenu:minimize,maximize,close'\'''
    dconf write '/org/gnome/desktop/interface/clock-show-date' 'true'
    mkdir -p "$(dirname "$wmark")" && date '+%F' > "$wmark"
fi

VER=byte-theme-1
mark="${XDG_CONFIG_HOME:-$HOME/.config}/hardpoint/theme"
[[ $(cat "$mark" 2>/dev/null) == "$VER" ]] && exit 0
[[ -d /usr/share/themes/HardPoint-Dark ]] || exit 0
I=org.gnome.desktop.interface
gsettings set $I color-scheme prefer-dark
gsettings set $I gtk-theme HardPoint-Dark
for icons in HardPoint-Dark Papirus-Dark; do
    [[ -d /usr/share/icons/$icons ]] && { gsettings set $I icon-theme $icons; break; }
done
gsettings list-schemas 2>/dev/null | grep -qx org.gnome.shell.extensions.user-theme &&
    gsettings set org.gnome.shell.extensions.user-theme name HardPoint-Dark
mkdir -p "$(dirname "$mark")" && echo "$VER" > "$mark"
