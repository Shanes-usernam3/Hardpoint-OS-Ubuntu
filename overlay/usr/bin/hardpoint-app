#!/usr/bin/python3
"""HardPoint OS apps — Setup, Updates, Accounts and Security.

One small GTK window with a WebKit view showing the Byte-style UI in
/usr/lib/hardpoint/ui. The page asks this program to do things through a
fixed list of commands; anything that needs admin rights goes through
pkexec + /usr/lib/hardpoint/hp-helper (which re-checks every argument).

    hardpoint-app setup [--first-run]
    hardpoint-app updates | accounts | security | system
"""
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import threading
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import GLib, Gtk, WebKit2  # noqa: E402

UI = Path(os.environ.get("HP_UI_DIR", "/usr/lib/hardpoint/ui"))
HELPER = os.environ.get("HP_HELPER", "/usr/lib/hardpoint/hp-helper")
UPDATES = os.environ.get("HP_UPDATES", "/usr/lib/hardpoint/hp-updates")
CATALOG = Path("/usr/share/hardpoint/flatpaks.list")
PKGS = Path("/usr/share/hardpoint/pkgs")
CONF_DIR = Path(GLib.get_user_config_dir()) / "hardpoint"
SETUP_DONE = CONF_DIR / "setup-done"

VIEWS = {
    "setup": ("HardPoint Setup", 1040, 700),
    "updates": ("HardPoint Updates", 1000, 680),
    "accounts": ("HardPoint Accounts", 1000, 680),
    "security": ("HardPoint Security", 1000, 680),
    "system": ("HardPoint System", 1000, 700),
}
ROOT_ACTIONS = {"entra-enable", "entra-disable", "lockdown", "usb-allow", "flatpak-install",
                "apt-refresh", "apply-updates", "battery", "windows-drive", "repair", "disk-health",
                "touchpad-fix"}
OPENERS = {
    "company-portal": ["intune-portal"],
    "software": ["plasma-discover"],
    "terminal": ["konsole"],
    "users": ["systemsettings", "kcm_users"],
    "appearance": ["systemsettings", "kcm_lookandfeel"],
    "firmware": ["plasma-discover", "--mode", "update"],
    "snapshots": ["timeshift-launcher"],
    "updates": ["hardpoint-app", "updates"],
    "accounts": ["hardpoint-app", "accounts"],
    "security": ["hardpoint-app", "security"],
    "system": ["hardpoint-app", "system"],
    "files-windows": ["xdg-open", "/mnt/Windows"],
    "sound": ["systemsettings", "kcm_pulseaudio"],
    "wifi": ["systemsettings", "kcm_networkmanagement"],
    "fingerprint": ["systemsettings", "kcm_users"],
}
URLS = re.compile(r"^https://(entra\.microsoft\.com|intune\.microsoft\.com|portal\.manage\.microsoft\.com|"
                  r"github\.com/Shanes-usernam3|learn\.microsoft\.com|www\.xbox\.com|pcsupport\.lenovo\.com)(/[\w\-./?=&#%]*)?$")


def sh(*cmd, timeout=20):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return 127, ""


def read_catalog():
    apps = []
    if CATALOG.exists():
        for line in CATALOG.read_text().splitlines():
            if not line.strip() or line.startswith("#"):
                continue
            parts = line.split("|")
            if len(parts) >= 5:
                apps.append({"category": parts[0], "id": parts[1], "name": parts[2],
                             "default": parts[3] == "1", "description": parts[4]})
    return apps


WEBAPP_DIR = Path("/usr/local/share/applications")


def installed_apps(catalog):
    """Catalog ids that are installed: Flatpak, apt:, web: and extra: entries."""
    rc, out = sh("flatpak", "list", "--app", "--columns=application")
    have = set(out.split()) if rc == 0 else set()
    apt_ids = [a["id"] for a in catalog if a["id"].startswith("apt:")]
    pkgs = sorted({p for i in apt_ids for p in i[4:].split(",")} | {"ipscan"})
    rc, out = sh("dpkg-query", "-W", "-f=${Package} ${db:Status-Status}\n", *pkgs)
    ok = {ln.split()[0] for ln in out.splitlines() if ln.endswith(" installed")}
    for i in apt_ids:
        if all(p in ok for p in i[4:].split(",")):
            have.add(i)
    for a in catalog:
        i = a["id"]
        if i.startswith("web:") and (WEBAPP_DIR / f"hp-web-{i[4:]}.desktop").exists():
            have.add(i)
    if Path("/opt/ventoy/VentoyGUI.x86_64").exists():
        have.add("extra:ventoy")
    if "ipscan" in ok:
        have.add("extra:angryip")
    if Path("/usr/local/bin/netlify").exists():
        have.add("extra:netlify")
    return sorted(have)


def rd(path, default=""):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return default


def battery_info():
    for b in sorted(Path("/sys/class/power_supply").glob("BAT*")):
        def num(*names):
            for n in names:
                v = rd(b / n)
                if v.isdigit():
                    return int(v)
            return 0
        full, design = num("energy_full", "charge_full"), num("energy_full_design", "charge_full_design")
        return {"present": True, "percent": num("capacity"), "status": rd(b / "status"),
                "health": round(100 * full / design) if full and design else None,
                "cycles": num("cycle_count") or None, "model": rd(b / "model_name"),
                "manufacturer": rd(b / "manufacturer")}
    return {"present": False}


def hardware_checks():
    """Quick check that the laptop's main parts have working drivers."""
    checks = []
    def add(key, name, ok, detail, fix=""):
        checks.append({"key": key, "name": name, "ok": ok, "detail": detail, "fix": fix})
    inputs = rd("/proc/bus/input/devices")
    i2c_touchpad_hw = any("PNP0C50" in rd(p / "firmware_node" / "hid") or "ACPI0C50" in rd(p / "firmware_node" / "hid")
                          for p in Path("/sys/bus/i2c/devices").glob("*"))
    tp = re.search(r"^N: Name=.*(touchpad|synaptics|elan|SYNA|ELAN)", inputs, re.I | re.M)
    if tp or i2c_touchpad_hw:
        add("touchpad", "Touchpad", bool(tp), "Working" if tp else "Not detected", "" if tp else "touchpad-fix")
    wifi = [p.parent.name for p in Path("/sys/class/net").glob("*/wireless")]
    add("wifi", "Wi-Fi", bool(wifi), f"Adapter {wifi[0]} ready" if wifi else "No Wi-Fi adapter found", "" if wifi else "wifi")
    cards = rd("/proc/asound/cards")
    snd = bool(cards) and "no soundcards" not in cards
    add("audio", "Sound", snd, "Sound card found" if snd else "No sound card found", "" if snd else "sound")
    drv = ""
    for c in Path("/sys/class/drm").glob("card[0-9]"):
        try:
            drv = os.path.basename(os.readlink(c / "device" / "driver"))
            break
        except OSError:
            pass
    accel = Path("/dev/dri/renderD128").exists()
    add("graphics", "Graphics", accel, f"Hardware acceleration on ({drv or 'GPU'})" if accel else "Using software drawing (slow)")
    bt = any(Path("/sys/class/bluetooth").glob("hci*"))
    add("bluetooth", "Bluetooth", bt, "Ready" if bt else "Not found or switched off")
    cam = any(Path("/dev").glob("video*"))
    add("camera", "Camera", cam, "Found" if cam else "Not found (check the privacy shutter / F-key)")
    rc, out = sh("fprintd-list", os.environ.get("USER", "root"), timeout=8)
    if "No devices available" not in out and rc != 127:
        enrolled = "Fingerprints for user" in out
        add("fingerprint", "Fingerprint reader", True,
            "Ready — finger enrolled" if enrolled else "Found — add a finger in Settings → Users",
            "" if enrolled else "fingerprint")
    return checks


def system_info():
    dmi = Path("/sys/class/dmi/id")
    vendor, product, version = rd(dmi / "sys_vendor"), rd(dmi / "product_name"), rd(dmi / "product_version")
    # Lenovo puts the marketing name in product_version and the machine type in product_name
    model = version if vendor.upper().startswith("LENOVO") and version else product
    cpu = re.search(r"^model name\s*:\s*(.+)$", rd("/proc/cpuinfo"), re.M)
    mem = re.search(r"^MemTotal:\s*(\d+)", rd("/proc/meminfo"), re.M)
    rc, gpu = sh("bash", "-c", "lspci -mm | awk -F'\"' '/VGA|3D|Display/ {print $4\" \"$6; exit}'")
    rc, disks = sh("lsblk", "-dJbo", "NAME,MODEL,SIZE,TYPE,TRAN")
    try:
        dl = [d for d in json.loads(disks)["blockdevices"] if d["type"] == "disk" and int(d.get("size") or 0) > 0 and not d["name"].startswith(("zram", "loop"))]
    except (ValueError, KeyError):
        dl = []
    rc, batt_state = sh("/usr/lib/hardpoint/hp-battery", "status")
    how, _, on = batt_state.partition(" ")
    fst = rd("/etc/fstab")
    up = float(rd("/proc/uptime", "0").split()[0] or 0)
    return {
        "vendor": vendor.title() if vendor.isupper() else vendor, "model": model, "machineType": product,
        "serial": rd("/var/lib/hardpoint/serial"), "bios": f"{rd(dmi / 'bios_version')} ({rd(dmi / 'bios_date')})",
        "cpu": re.sub(r"\s+", " ", cpu.group(1)) if cpu else "", "ramGB": round(int(mem.group(1)) / 1048576) if mem else 0,
        "gpu": re.sub(r" (Corporation|Corp\.|Inc\.|\[AMD/ATI\])", "", gpu), "os": os_info().get("PRETTY_NAME", ""), "kernel": os.uname().release,
        "uptimeH": round(up / 3600, 1),
        "disks": [{"name": d["name"], "model": (d.get("model") or "").strip(), "sizeGB": round(int(d["size"]) / 1e9),
                   "tran": d.get("tran") or ""} for d in dl],
        "battery": battery_info(),
        "chargeLimit": {"supported": how not in ("", "none"), "on": on == "on", "method": how},
        "windowsDrive": "# hardpoint-windows-drive" in fst,
        "checks": hardware_checks(),
    }


def is_live():
    """Running from the USB stick / DVD (live session)?"""
    return "boot=casper" in Path("/proc/cmdline").read_text() or os.path.ismount("/cdrom")


def color_scheme():
    """'prefer-dark' or 'default', from the Plasma colour scheme."""
    name = sh("kreadconfig6", "--file", "kdeglobals", "--group", "General", "--key", "ColorScheme")[1]
    if not name:
        return "prefer-dark"
    return "default" if "light" in name.lower() else "prefer-dark"


def os_info():
    info = {}
    try:
        for line in Path("/etc/os-release").read_text().splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                info[k] = v.strip('"')
    except OSError:
        pass
    return info


def entra_state():
    conf = Path("/etc/himmelblau/himmelblau.conf")
    domain = ""
    if conf.exists():
        m = re.search(r"^domains?\s*=\s*(\S+)", conf.read_text(), re.M)
        domain = m.group(1) if m else ""
    rc, _ = sh("dpkg-query", "-W", "-f=${Status}", "himmelblau")
    installed = rc == 0
    active = sh("systemctl", "is-active", "himmelblaud")[1] == "active"
    return {"available": any(PKGS.glob("himmelblau_*.deb")) or installed,
            "enabled": installed and bool(domain), "domain": domain, "active": active,
            "companyPortal": shutil.which("intune-portal") is not None}


def security_state():
    sb = "unknown"
    for f in Path("/sys/firmware/efi/efivars").glob("SecureBoot-*"):
        try:
            sb = "on" if f.read_bytes()[4] == 1 else "off"
        except (OSError, IndexError):
            pass
    lockdown_kernel = ""
    try:
        m = re.search(r"\[(\w+)\]", Path("/sys/kernel/security/lockdown").read_text())
        lockdown_kernel = m.group(1) if m else ""
    except OSError:
        pass
    luks = sh("bash", "-c", "lsblk -rno TYPE | grep -qx crypt")[0] == 0
    return {
        "lockdown": Path("/etc/hardpoint/lockdown").exists(),
        "firewall": sh("systemctl", "is-active", "ufw")[1] == "active",
        "apparmor": sh("systemctl", "is-active", "apparmor")[1] == "active",
        "secureBoot": sb,
        "kernelLockdown": lockdown_kernel,
        "encrypted": luks,
        "usbguard": sh("systemctl", "is-active", "usbguard")[1] == "active",
    }


def state():
    osr = os_info()
    catalog = read_catalog()
    pw = Path("/etc/passwd")
    user = os.environ.get("USER") or os.getlogin()
    real = user
    try:
        for line in pw.read_text().splitlines():
            f = line.split(":")
            if f[0] == user and len(f) > 4 and f[4]:
                real = f[4].split(",")[0]
    except OSError:
        pass
    return {
        "user": user, "realName": real, "host": os.uname().nodename,
        "os": osr.get("PRETTY_NAME", "HardPoint OS"),
        "live": is_live(),
        "setupDone": SETUP_DONE.exists(),
        "catalog": catalog,
        "installedApps": installed_apps(catalog),
        "entra": entra_state(),
        "security": security_state(),
        "updateTimer": sh("systemctl", "--user", "is-enabled", "hardpoint-update-check.timer")[1] == "enabled",
        "colorScheme": color_scheme(),
    }


class App(Gtk.Window):
    def __init__(self, view, first_run):
        title, w, h = VIEWS[view]
        super().__init__(title=title)
        self.set_default_size(w, h)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("hardpoint")
        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", True)

        mgr = WebKit2.UserContentManager()
        mgr.connect("script-message-received::hp", self.on_message)
        mgr.register_script_message_handler("hp")
        self.web = WebKit2.WebView.new_with_user_content_manager(mgr)
        s = self.web.get_settings()
        s.set_enable_developer_extras(bool(os.environ.get("HP_DEBUG")))
        s.set_allow_file_access_from_file_urls(True)
        s.set_enable_write_console_messages_to_stdout(bool(os.environ.get("HP_DEBUG")))
        self.web.set_background_color(_rgba(10, 14, 23))
        self.web.connect("decide-policy", self.on_policy)
        self.web.connect("context-menu", lambda *a: not os.environ.get("HP_DEBUG"))
        q = f"view={view}" + ("&first=1" if first_run else "")
        self.web.load_uri((UI / "index.html").as_uri() + "?" + q)
        self.add(self.web)
        self.connect("destroy", Gtk.main_quit)

    # Links never navigate inside the window; allowed ones open in the browser.
    def on_policy(self, web, decision, kind):
        if kind == WebKit2.PolicyDecisionType.NAVIGATION_ACTION:
            uri = decision.get_navigation_action().get_request().get_uri()
            if uri.startswith((UI.as_uri())):
                return False
            decision.ignore()
            if URLS.match(uri):
                subprocess.Popen(["xdg-open", uri])
            return True
        return False

    # ---- page <-> app bridge
    def js(self, code):
        if hasattr(self.web, "evaluate_javascript"):
            self.web.evaluate_javascript(code, -1, None, None, None, None, None)
        else:
            self.web.run_javascript(code, None, None, None)

    def reply(self, rid, ok, data):
        self.js(f"HP._reply({json.dumps(rid)}, {json.dumps(ok)}, {json.dumps(data)})")
        return False

    def line(self, rid, text):
        self.js(f"HP._line({json.dumps(rid)}, {json.dumps(text)})")
        return False

    def on_message(self, mgr, res):
        try:
            v = res.get_js_value() if hasattr(res, "get_js_value") else res
            msg = json.loads(v.to_string())
        except Exception:
            return
        rid, cmd = msg.get("id"), msg.get("cmd")
        args = msg.get("args") or []
        if not isinstance(args, list) or not all(isinstance(a, str) for a in args):
            return self.reply(rid, False, "bad arguments")
        try:
            if cmd == "state":
                threading.Thread(target=lambda: GLib.idle_add(self.reply, rid, True, state()), daemon=True).start()
            elif cmd == "root" and msg.get("action") in ROOT_ACTIONS:
                self.stream(rid, ["pkexec", HELPER, msg["action"], *args])
            elif cmd == "updates-list":
                self.capture_json(rid, [UPDATES, "list"])
            elif cmd == "open" and msg.get("app") in OPENERS:
                exe = OPENERS[msg["app"]]
                if shutil.which(exe[0]):
                    subprocess.Popen(exe, start_new_session=True)
                    self.reply(rid, True, "")
                else:
                    self.reply(rid, False, f"{exe[0]} is not installed")
            elif cmd == "url" and URLS.match(msg.get("url", "")):
                subprocess.Popen(["xdg-open", msg["url"]])
                self.reply(rid, True, "")
            elif cmd == "appearance" and args and args[0] in ("dark", "light"):
                dark = args[0] == "dark"
                sh("plasma-apply-colorscheme", "HardPointDark" if dark else "HardPointLight")
                icons = "Papirus-Dark" if dark else "Papirus"
                sh("kwriteconfig6", "--file", "kdeglobals", "--group", "Icons", "--key", "Theme", icons)
                changer = next(iter(glob.glob("/usr/lib/*/libexec/plasma-changeicons") + glob.glob("/usr/libexec/plasma-changeicons")), None)
                if changer:
                    sh(changer, icons)
                self.reply(rid, True, "prefer-dark" if dark else "default")
            elif cmd == "update-timer" and args and args[0] in ("on", "off"):
                verb = "enable" if args[0] == "on" else "disable"
                rc, _ = sh("systemctl", "--user", verb, "--now", "hardpoint-update-check.timer")
                self.reply(rid, rc == 0, args[0])
            elif cmd == "sysinfo":
                threading.Thread(target=lambda: GLib.idle_add(self.reply, rid, True, system_info()), daemon=True).start()
            elif cmd == "copy" and args and len(args[0]) < 200:
                from gi.repository import Gdk
                Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(args[0], -1)
                self.reply(rid, True, "")
            elif cmd == "setup-done":
                CONF_DIR.mkdir(parents=True, exist_ok=True)
                SETUP_DONE.write_text("done\n")
                self.reply(rid, True, "")
            elif cmd == "close":
                Gtk.main_quit()
            else:
                self.reply(rid, False, f"unknown command {cmd}")
        except Exception as e:  # never leave the page waiting
            self.reply(rid, False, str(e))

    def stream(self, rid, argv):
        def run():
            try:
                p = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
                for ln in p.stdout:
                    GLib.idle_add(self.line, rid, ln.rstrip("\n"))
                rc = p.wait()
            except OSError as e:
                GLib.idle_add(self.line, rid, str(e))
                rc = 127
            # pkexec: 126 = dialog dismissed, 127 = not authorised
            msg = {0: "done", 126: "cancelled", 127: "not authorised"}.get(rc, f"failed ({rc})")
            GLib.idle_add(self.reply, rid, rc == 0, msg)
        threading.Thread(target=run, daemon=True).start()

    def capture_json(self, rid, argv):
        def run():
            rc, out = sh(*argv, timeout=180)
            try:
                data = json.loads(out) if out else {}
                GLib.idle_add(self.reply, rid, rc == 0, data)
            except ValueError:
                GLib.idle_add(self.reply, rid, False, out[-500:])
        threading.Thread(target=run, daemon=True).start()


def _rgba(r, g, b):
    from gi.repository import Gdk
    c = Gdk.RGBA()
    c.red, c.green, c.blue, c.alpha = r / 255, g / 255, b / 255, 1
    return c


def main():
    args = sys.argv[1:]
    view = args[0] if args and args[0] in VIEWS else "setup"
    first = "--first-run" in args
    if first:
        if SETUP_DONE.exists() or is_live():
            return
    App(view, first).show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
